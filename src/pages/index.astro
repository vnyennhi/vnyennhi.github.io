            </section>
        </div>
    </section>

    <div class="travel-panel" id="travel-panel" role="dialog" aria-modal="true" aria-labelledby="travel-title" hidden>
        <div class="travel-panel-backdrop" data-travel-close></div>
        <section class="travel-panel-card" tabindex="-1">
            <button class="travel-close" type="button" data-travel-close aria-label="Close travel map">Close</button>
            <div>
                <p class="bento-kicker">travel map</p>
                <h2 id="travel-title">Countries I visit</h2>
            </div>
            <div class="travel-map-toolbar" role="group" aria-label="Travel view">
                <button type="button" class="is-active" data-travel-mode="globe" aria-pressed="true">Globe</button>
                <button type="button" data-travel-mode="map" aria-pressed="false">Map</button>
            </div>
            <div class="travel-map-wrap" data-travel-map data-countries={travelCountryData}>
                <svg class="travel-map" data-travel-svg role="img" aria-label="World map rendering visited countries"></svg>
                <p class="travel-country-note" data-travel-country-note aria-live="polite" hidden></p>
                <div class="travel-map-status" data-travel-status aria-live="polite" hidden>Loading map</div>
            </div>
        </section>
    </div>
</BaseLayout>

<script is:inline type="module">
    const TRAVEL_ASSETS = {
        d3: 'https://cdn.jsdelivr.net/npm/d3@7/+esm',
        topojson: 'https://cdn.jsdelivr.net/npm/topojson-client@3/+esm',
        world: 'https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json'
    };

    function initColorControls() {
        const buttons = document.querySelectorAll('[data-color-choice]');
        const currentColor = localStorage.getItem('color-theme') || 'ember';

        const setColor = (color) => {
            document.documentElement.setAttribute('data-color-theme', color);
            localStorage.setItem('color-theme', color);
            buttons.forEach((button) => {
                button.setAttribute('aria-pressed', button.getAttribute('data-color-choice') === color ? 'true' : 'false');
            });
        };

        setColor(currentColor);

        buttons.forEach((button) => {
            if (button.getAttribute('data-bound') === 'true') return;
            button.setAttribute('data-bound', 'true');
            button.addEventListener('click', () => {
                const color = button.getAttribute('data-color-choice');
                if (color) setColor(color);
            });
        });
    }

    function initThemeModeControls() {
        const buttons = document.querySelectorAll('[data-theme-mode]');
        const preferenceSet = localStorage.getItem('theme-preference-set') === 'true';
        const currentTheme = preferenceSet && localStorage.getItem('theme') === 'light' ? 'light' : 'dark';

        const setTheme = (theme, persist = true) => {
            const isDark = theme === 'dark';
            document.documentElement.classList.toggle('dark', isDark);
            if (persist) {
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
                localStorage.setItem('theme-preference-set', 'true');
            }
            buttons.forEach((button) => {
                button.setAttribute('aria-pressed', button.getAttribute('data-theme-mode') === theme ? 'true' : 'false');
            });
        };

        setTheme(currentTheme, false);

        buttons.forEach((button) => {
            if (button.getAttribute('data-bound') === 'true') return;
            button.setAttribute('data-bound', 'true');
            button.addEventListener('click', () => {
                const theme = button.getAttribute('data-theme-mode');
                if (theme === 'dark' || theme === 'light') setTheme(theme);
            });
        });
    }

    function initHomeTime() {
        const clock = document.querySelector('[data-home-time]');
        const date = document.querySelector('[data-home-date]');
        if (!clock) return;

        const render = () => {
            const now = new Date();
            const timeFormatter = new Intl.DateTimeFormat([], {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: false
            });
            clock.textContent = timeFormatter.format(now);
            clock.setAttribute('datetime', now.toISOString());
            clock.setAttribute('data-second', String(now.getSeconds()));

            if (date) {
                const dateFormatter = new Intl.DateTimeFormat([], {
                    weekday: 'short',
                    month: 'short',
                    day: 'numeric'
                });
                date.textContent = dateFormatter.format(now);
            }
        };

        if (window.homeTimeInterval) window.clearInterval(window.homeTimeInterval);
        render();
        window.homeTimeInterval = window.setInterval(render, 1000);
    }

    function initKnowledgeGraph() {
        const svg = document.querySelector('[data-knowledge-graph]');
        if (!svg || svg.getAttribute('data-rendered') === 'true') return;
        svg.setAttribute('data-rendered', 'true');

        const graph = JSON.parse(svg.getAttribute('data-graph') || '{"nodes":[],"links":[]}');
        const namespace = 'http://www.w3.org/2000/svg';
        const nodeById = new Map(graph.nodes.map((node) => [node.id, node]));
        const linkElements = [];
        const nodeElements = [];
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        svg.innerHTML = '';

        const linksLayer = document.createElementNS(namespace, 'g');
        linksLayer.setAttribute('class', 'knowledge-links');
        svg.append(linksLayer);

        const nodesLayer = document.createElementNS(namespace, 'g');
        nodesLayer.setAttribute('class', 'knowledge-nodes');
        svg.append(nodesLayer);

        graph.links.forEach(([sourceId, targetId], index) => {
            const source = nodeById.get(sourceId);
            const target = nodeById.get(targetId);
            if (!source || !target) return;

            const path = document.createElementNS(namespace, 'path');
            path.setAttribute('class', `knowledge-link link-${index % 4}`);
            linksLayer.append(path);
            linkElements.push({ path, source, target, index });
        });

        graph.nodes.forEach((node) => {
            const group = document.createElementNS(namespace, 'g');
            group.setAttribute('class', `knowledge-node is-${node.kind}`);

            const circle = document.createElementNS(namespace, 'circle');
            circle.setAttribute('r', node.size || (node.kind === 'core' ? 18 : 7));

            const label = document.createElementNS(namespace, 'text');
            label.textContent = node.label || node.id;
            label.setAttribute('y', node.kind === 'core' ? '4' : node.size > 8 ? '21' : '17');

            group.append(circle, label);
            nodesLayer.append(group);
            nodeElements.push({ group, node });
        });

        const render = (time = 0) => {
            const drift = prefersReducedMotion.matches ? 0 : Math.sin(time / 900);

            nodeElements.forEach(({ group, node }, index) => {
                const wobble = node.kind === 'core' ? 0 : Math.sin(time / 1200 + index) * 2.8;
                node.renderX = node.x + wobble;
                node.renderY = node.y + drift * (node.kind === 'core' ? 0 : 2);
                group.setAttribute('transform', `translate(${node.renderX} ${node.renderY})`);
            });

            linkElements.forEach(({ path, source, target, index }) => {
                const sourceX = source.renderX ?? source.x;
                const sourceY = source.renderY ?? source.y;
                const targetX = target.renderX ?? target.x;
                const targetY = target.renderY ?? target.y;
                const midX = (sourceX + targetX) / 2;
                const midY = (sourceY + targetY) / 2;
                const offset = ((index % 5) - 2) * 5;
                path.setAttribute('d', `M ${sourceX} ${sourceY} Q ${midX + offset} ${midY - offset} ${targetX} ${targetY}`);
            });

            if (!prefersReducedMotion.matches) requestAnimationFrame(render);
        };

        render();
    }

    function initTravelPanel() {
        const panel = document.getElementById('travel-panel');
        const trigger = document.querySelector('.travel-trigger');
        if (!panel || !trigger) return;

        const closeButtons = panel.querySelectorAll('[data-travel-close]');
        const card = panel.querySelector('.travel-panel-card');
        const openPanel = async () => {
            panel.hidden = false;
            trigger.setAttribute('aria-expanded', 'true');
            document.documentElement.classList.add('travel-open');
            panel.setAttribute('data-open', 'true');
            card?.focus();
            const controller = await initTravelMap(panel);
            controller?.setMode('globe');
        };
        const closePanel = () => {
            panel.removeAttribute('data-open');
            panel.querySelector('[data-travel-map]')?.travelMapController?.stop();
            panel.hidden = true;
            trigger.setAttribute('aria-expanded', 'false');
            document.documentElement.classList.remove('travel-open');
            trigger.focus();
        };

        if (trigger.getAttribute('data-bound') !== 'true') {
            trigger.setAttribute('data-bound', 'true');
            trigger.addEventListener('click', openPanel);
        }

        closeButtons.forEach((button) => {
            if (button.getAttribute('data-bound') === 'true') return;
            button.setAttribute('data-bound', 'true');
            button.addEventListener('click', closePanel);
        });

        if (panel.getAttribute('data-key-bound') !== 'true') {
            panel.setAttribute('data-key-bound', 'true');
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && !panel.hidden) closePanel();
            });
        }
    }

    async function initTravelMap(panel) {
        const mount = panel.querySelector('[data-travel-map]');
        const svgElement = panel.querySelector('[data-travel-svg]');
        const status = panel.querySelector('[data-travel-status]');
        const countryNote = panel.querySelector('[data-travel-country-note]');
        if (!mount || !svgElement) return null;
        if (mount.travelMapController) return mount.travelMapController;

        const countries = JSON.parse(mount.getAttribute('data-countries') || '[]');
        const visitedById = new Map(countries.map((country) => [normalizeCountryId(country.id), country]));
        const visitedIds = new Set(visitedById.keys());
        const modeButtons = panel.querySelectorAll('[data-travel-mode]');
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let d3;
        let topojson;
        let features = [];
        let mode = 'globe';
        let rotation = -115;
        let frame = 0;
        let previousTick = 0;
        let selectedCountryId = '';

        const setStatus = (message) => {
            if (!status) return;
            status.textContent = message;
            status.hidden = !message;
        };

        const selectCountry = (country) => {
            selectedCountryId = normalizeCountryId(country.id);
            if (countryNote) {
                countryNote.textContent = country.name;
                countryNote.hidden = false;
            }
            if (mode === 'globe') stop();
            render();
        };

        const clearCountrySelection = () => {
            if (!selectedCountryId && countryNote?.hidden) {
                if (mode === 'globe') start();
                return;
            }
            selectedCountryId = '';
            if (countryNote) {
                countryNote.textContent = '';
                countryNote.hidden = true;
            }
            render();
            if (mode === 'globe') start();
        };

        const renderFallback = () => {
            const width = Math.max(320, Math.round(mount.getBoundingClientRect().width || 640));
            const height = Math.max(320, Math.round(Math.min(520, width * 0.62)));
            svgElement.setAttribute('viewBox', `0 0 ${width} ${height}`);
            svgElement.innerHTML = '';

            const namespace = 'http://www.w3.org/2000/svg';
            const sphere = document.createElementNS(namespace, 'circle');
            sphere.setAttribute('class', 'travel-ocean');
            sphere.setAttribute('cx', String(width / 2));
            sphere.setAttribute('cy', String(height / 2));
            sphere.setAttribute('r', String(Math.min(width, height) * 0.42));
            svgElement.append(sphere);

            [-60, -30, 0, 30, 60].forEach((offset) => {
                const line = document.createElementNS(namespace, 'ellipse');
                line.setAttribute('class', 'travel-graticule');
                line.setAttribute('cx', String(width / 2));
                line.setAttribute('cy', String(height / 2));
                line.setAttribute('rx', String(Math.min(width, height) * 0.42));
                line.setAttribute('ry', String(Math.min(width, height) * (0.42 - Math.abs(offset) / 260)));
                svgElement.append(line);
            });

            setStatus('Map data unavailable');
        };

        const render = () => {
            if (!features.length || !d3) {
                renderFallback();
                return;
            }

            const width = Math.max(320, Math.round(mount.getBoundingClientRect().width || 720));
            const height = mode === 'globe' ? Math.max(320, Math.round(Math.min(560, width * 0.66))) : Math.max(300, Math.round(Math.min(520, width * 0.52)));
            const svg = d3.select(svgElement);
            const sphere = { type: 'Sphere' };
            const projection =
                mode === 'globe'
                    ? d3
                            .geoOrthographic()
                            .translate([width / 2, height / 2])
                            .scale(Math.min(width, height) * 0.44)
                            .rotate([rotation, -12])
                            .clipAngle(90)
                    : d3.geoEqualEarth().fitExtent(
                            [
                                [12, 16],
                                [width - 12, height - 16]
                            ],
                            sphere
                        );
            const path = d3.geoPath(projection);

            svg.attr('viewBox', `0 0 ${width} ${height}`).selectAll('*').remove();
            svg.append('path').datum(sphere).attr('class', 'travel-ocean').attr('d', path).on('click', clearCountrySelection);
            svg.append('path').datum(d3.geoGraticule10()).attr('class', 'travel-graticule').attr('d', path);
            svg
                .append('g')
                .attr('class', 'travel-country-layer')
                .selectAll('path')
                .data(features)
                .join('path')
                .attr('class', (feature) => {
                    const countryId = normalizeCountryId(feature.id);
                    const stateClass = visitedIds.has(countryId) ? ' is-visited' : '';
                    const selectedClass = countryId === selectedCountryId ? ' is-selected' : '';
                    return `travel-country${stateClass}${selectedClass}`;
                })
                .attr('d', path)
                .attr('data-country-id', (feature) => normalizeCountryId(feature.id))
                .attr('tabindex', (feature) => (visitedIds.has(normalizeCountryId(feature.id)) ? '0' : null))
                .attr('role', (feature) => (visitedIds.has(normalizeCountryId(feature.id)) ? 'button' : null))
                .attr('aria-label', (feature) => {
                    const country = visitedById.get(normalizeCountryId(feature.id));
                    return country ? `${country.name} visited` : null;
                })
                .on('click', (event, feature) => {
                    const country = visitedById.get(normalizeCountryId(feature.id));
                    if (country) {
                        event.stopPropagation();
                        selectCountry(country);
                    } else {
                        clearCountrySelection();
                    }
                })
                .on('pointerenter', (event, feature) => {
                    if (mode !== 'globe') return;
                    const country = visitedById.get(normalizeCountryId(feature.id));
                    if (country) selectCountry(country);
                })
                .on('focus', (event, feature) => {
                    const country = visitedById.get(normalizeCountryId(feature.id));
                    if (country) selectCountry(country);
                })
                .on('keydown', (event, feature) => {
                    if (event.key !== 'Enter' && event.key !== ' ') return;
                    const country = visitedById.get(normalizeCountryId(feature.id));
                    if (!country) return;
                    event.preventDefault();
                    selectCountry(country);
                })
                .append('title')
                .text((feature) => visitedById.get(normalizeCountryId(feature.id))?.name || '');
            svg.append('path').datum(sphere).attr('class', 'travel-sphere-edge').attr('d', path);
        };

        const start = () => {
            if (mode !== 'globe' || prefersReducedMotion.matches || frame) return;
            previousTick = performance.now();
            const tick = (time) => {
                const elapsed = time - previousTick;
                previousTick = time;
                rotation = (rotation + elapsed * 0.006) % 360;
                render();
                frame = requestAnimationFrame(tick);
            };
            frame = requestAnimationFrame(tick);
        };

        const stop = () => {
            if (!frame) return;
            cancelAnimationFrame(frame);
            frame = 0;
        };

        const setMode = (nextMode) => {
            mode = nextMode;
            modeButtons.forEach((button) => {
                const active = button.getAttribute('data-travel-mode') === mode;
                button.classList.toggle('is-active', active);
                button.setAttribute('aria-pressed', active ? 'true' : 'false');
            });
            if (mode === 'globe') {
                render();
                start();
            } else {
                stop();
                render();
            }
        };

        modeButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const nextMode = button.getAttribute('data-travel-mode');
                if (nextMode === 'globe' || nextMode === 'map') setMode(nextMode);
            });
        });

        window.addEventListener('resize', render);
        const observer = new ResizeObserver(render);
        observer.observe(mount);

        const controller = { start, stop, render, setMode };
        mount.travelMapController = controller;

        try {
            setStatus('Loading map');
            [d3, topojson] = await Promise.all([import(TRAVEL_ASSETS.d3), import(TRAVEL_ASSETS.topojson)]);
            const world = await fetch(TRAVEL_ASSETS.world).then((response) => {
                if (!response.ok) throw new Error('Map data failed to load');
                return response.json();
            });
            features = topojson.feature(world, world.objects.countries).features.map((feature) => trimCountryFeature(feature, d3));
            setStatus('');
            render();
        } catch (error) {
            setStatus('');
            renderFallback();
        }

        return controller;
    }

    function normalizeCountryId(id) {
        return String(id).padStart(3, '0');
    }

    function trimCountryFeature(feature, d3) {
        if (normalizeCountryId(feature.id) !== '250' || feature.geometry?.type !== 'MultiPolygon') return feature;

        const mainlandPolygon = feature.geometry.coordinates.reduce((largest, polygon) => {
            const polygonArea = d3.geoArea({ type: 'Polygon', coordinates: polygon });
            const largestArea = d3.geoArea({ type: 'Polygon', coordinates: largest });
            return polygonArea > largestArea ? polygon : largest;
        }, feature.geometry.coordinates[0]);

        return {
            ...feature,
            geometry: {
                type: 'Polygon',
                coordinates: mainlandPolygon
            }
        };
    }

    initColorControls();
    initThemeModeControls();
    initHomeTime();
    initKnowledgeGraph();
    initTravelPanel();
    document.addEventListener('astro:page-load', () => {
        initColorControls();
        initThemeModeControls();
        initHomeTime();
        initKnowledgeGraph();
        initTravelPanel();
    });
</script>
