---

<BaseLayout showHeader={false} showNav={false} showFooter={false} wide description={siteConfig.description} image={siteConfig.image}>
    <section class="home-bento" aria-labelledby="home-title">
        <div class="bento-grid">
            <section class="bento-card intro-card">
                <p class="bento-kicker">welcome</p>
                <h1 id="home-title">Nhi Vo</h1>
                <p class="intro-copy">
                    Welcome to my corner of code, curation, and curiosity. I build practical data systems, untangle messy questions, and keep a small archive for essays, experiments, travel notes, and the patterns I keep returning to.
                </p>
                <p class="intro-copy intro-copy-secondary">
                    My work sits between machine learning, statistical thinking, product analytics, and the human work of making complicated things readable.
                </p>
                <div class="intro-actions">
                    <a class="bento-button" href="/about">About me</a>
                    <a class="bento-button bento-button-strong" href="mailto:vnyennhi@gmail.com">
                        Contact
                        <ArrowRight class="h-4 w-4 fill-current" />
                    </a>
                </div>
            </section>

            <section class="bento-card portrait-card" aria-label="Portrait">
                <div class="portrait-frame">
                    <img src="/profile.jpg" alt="Caricature portrait of Nhi Vo" />
                </div>
            </section>

            <section class="bento-card about-card">
                <p class="bento-kicker">about me</p>
                <ul class="about-facts">
                    <li>Principal Data Scientist at Automattic.</li>
                    <li>I turn messy product signals into metrics, models, and stories teams can act on.</li>
                    <li>Ph.D. in Data Science from University of Technology Sydney.</li>
                    <li>Recent credentials in ML production, green software, Azure AI, and Google Compute Engine.</li>
                    <li>Research across knowledge graphs, NLP recommendation systems, churn, causal inference, and responsible investment.</li>
                </ul>
                <a class="text-link" href="/about">Read more <ArrowRight class="h-4 w-4 fill-current" /></a>
            </section>

            <section class="bento-card graph-card" aria-label="Profile knowledge graph">
                <div class="graph-card-copy">
                    <p class="bento-kicker">Profile Map</p>
                </div>
                <svg class="knowledge-graph" data-knowledge-graph data-graph={knowledgeGraphData} viewBox="0 0 520 280" role="img" aria-label="Knowledge graph of Nhi Vo's profile"></svg>
            </section>

            <section class="bento-card now-signal-card">
                <div>
                    <span class="live-dot" aria-hidden="true"></span>
                    <p class="bento-kicker">now</p>
                    <p>Making data useful, readable, and just opinionated enough.</p>
                </div>
                <div class="signal-board" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <i></i>
                </div>
            </section>

            <button class="bento-card travel-card travel-trigger" type="button" aria-haspopup="dialog" aria-controls="travel-panel">
                <img class="travel-gif" src={globeGif} alt="" aria-hidden="true" loading="lazy" decoding="async" />
                <span class="travel-card-shade" aria-hidden="true"></span>
                <span class="arrow-link" aria-hidden="true">
                    <ArrowRight class="h-5 w-5 fill-current" />
                </span>
                <span class="travel-card-copy">
                    <span class="bento-kicker">travel</span>
                    <span class="card-title">Countries I visit</span>
                </span>
            </button>

            <section class="bento-card palette-card">
                <p class="bento-kicker">colors</p>
                <div class="color-swatches" aria-label="Choose color theme">
                    <button type="button" class="color-swatch theme-ember" data-color-choice="ember" aria-label="Use red orange theme"></button>
                    <button type="button" class="color-swatch theme-sun" data-color-choice="sun" aria-label="Use yellow theme"></button>
                    <button type="button" class="color-swatch theme-blue" data-color-choice="blue" aria-label="Use blue theme"></button>
                    <button type="button" class="color-swatch theme-purple" data-color-choice="purple" aria-label="Use purple theme"></button>
                    <button type="button" class="color-swatch theme-green" data-color-choice="green" aria-label="Use green theme"></button>
                    <button type="button" class="color-swatch theme-rose" data-color-choice="rose" aria-label="Use rose theme"></button>
