---
import { ClientRouter } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';

export type Props = HeadProps & { showHeader?: boolean; showNav?: boolean; showFooter?: boolean; wide?: boolean };

const { showHeader = true, showNav = true, showFooter = true, wide = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="en" class="antialiased break-words">
    <head>
        <BaseHead {...head} />
        <script>
            const themePreferenceSet = localStorage.getItem('theme-preference-set') === 'true';
            const savedTheme = localStorage.getItem('theme');
            const theme = themePreferenceSet && savedTheme === 'light' ? 'light' : 'dark';
            if (!themePreferenceSet && savedTheme === 'light') {
                localStorage.removeItem('theme');
            }
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
            const savedColor = localStorage.getItem('color-theme');
            if (savedColor) {
                document.documentElement.setAttribute('data-color-theme', savedColor);
            }
        </script>
        <ClientRouter />
    </head>
    <body class="bg-main text-main">
        <div class="flex flex-col min-h-screen px-4 md:px-8">
            {showNav && <Nav />}
            {showHeader && <Header />}
            <main class:list={['grow w-full mx-auto', wide ? 'max-w-6xl' : 'max-w-3xl']}>
                <slot />
            </main>
            {showFooter && <Footer />}
        </div>
    </body>
</html>
